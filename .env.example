# Geral
PHOTOS_PER_BOOK=2
RAW_DIR=photos_raw
GROUPED_DIR=photos_grouped
# Pasta temporária para "Criar pasta de capas" em /bundle - cada clique cria
# uma subpasta com nome único aqui, apagada depois de "Marcar selecionados"
# (ou na próxima vez que o botão correr, se sobrar há mais de uma hora).
BUNDLE_TMP_DIR=bundle_tmp
TZ=Europe/Lisbon

# -------- DB (SQLite local) --------
DB_URL=sqlite:///./blt.db

# Preço fixo (sem negociação/transporte na descrição - Vinted trata do envio)
BOOK_PRICE_EUR=6

# Modo de desenvolvimento (ver comentário em config.py) - deixar false em uso real
DEV_MODE=false

# -------- Discord (opcional) --------
# Cria um webhook num canal: Definições do canal > Integrações > Webhooks > Novo Webhook.
# Deixa vazio para desativar os botões "Enviar para Discord".
DISCORD_WEBHOOK_URL=

# Bot + canal DEDICADO (nunca o mesmo canal do webhook acima) para `blt fetch-discord-photos`.
# Cria uma app em discord.com/developers/applications, copia o Bot Token, convida o bot
# para um canal novo com permissões "View Channel", "Read Message History" e "Manage
# Messages" (esta última é precisa para apagar a mensagem depois de descarregar a foto).
# Deixa ambos vazios para desativar o comando.
DISCORD_BOT_TOKEN=
DISCORD_PHOTOS_CHANNEL_ID=
